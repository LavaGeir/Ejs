<%- include('partials/header', { title: title, message: message }) %> <%# Inkluderer header-partialen med tittel og melding %>

<h1><%= title %></h1> <%# Sentrert via CSS (h1-regelen) %>

<section class="card"> <%# Kort med skjema for å legge til person %>
  <h2>Legg til Person</h2> <%# Seksjonstittel %>
  <form action="/people" method="POST" class="form"> <%# Skjema for å sende POST til /people %>
    <label for="name">Navn</label> <%# Etikett for navn %>
    <input id="name" name="name" type="text" required /> <%# Input for navn (påkrevd) %>

    <label for="birthyear">Fødselsår</label> <%# Etikett for fødselsår %>
    <input id="birthyear" name="birthyear" type="number" min="1800" max="<%= new Date().getFullYear() %>" step="1" required /> <%# Tallfelt for år %>

    <label for="nationality">Nasjonalitet</label> <%# Etikett for nasjonalitet %>
    <input id="nationality" name="nationality" type="text" required /> <%# Input for nasjonalitet %>

    <button type="submit">Lagre person</button> <%# Lagre-knapp %>
  </form> <%# Slutt skjema %>
</section> <%# Slutt kort %>

<section class="card"> <%# Kort som viser registrerte personer %>
  <h2>Registrerte personer</h2> <%# Seksjonstittel %>
  <ul> <%# Starter liste %>
    <% if (!people || people.length === 0) { %> <%# Hvis listen er tom %>
      <li>(Ingen personer enda)</li> <%# Tom-liste melding %>
    <% } %> <%# Slutt tom-sjekk %>
    <% for (const p of people) { %> <%# Løkker gjennom personer %>
      <li> <%# Ett listeelement per person %>
        <strong><%= p.name %></strong> <%# Navn %>
        –<%= new Date().getFullYear() - p.birthyear %> År gammel
        – nasjonalitet: <em><%= p.nationality %></em> <%# Nasjonalitetens navn %>
        <form action="/people/<%= p.id %>/delete" method="POST" style="display:inline;margin-left:8px"> <%# Slette-skjema %>
          <button type="submit">Slett</button> <%# Slette-knapp %>
        </form> <%# Slutt slette-skjema %>
      </li> <%# Slutt listeelement %>
    <% } %> <%# Slutt løkke %>
  </ul> <%# Slutt liste %>
</section> <%# Slutt kort %>

<%- include('partials/footer') %> <%# Inkluderer footer-partialen (lukker main/body/html) %>